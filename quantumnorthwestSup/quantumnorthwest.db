record(bo, "$(P)SIM")
{
    field(SCAN, "Passive")
    field(DTYP, "Soft Channel")
    field(ZNAM, "NO")
    field(ONAM, "YES")
    field(VAL, "$(RECSIM=0)")
    field(PINI, "YES")
}

record(bo, "$(P)DISABLE")
{
    field(DESC, "Disable comms")
    field(PINI, "YES")
    field(VAL, "$(DISABLE=0)")
    field(OMSL, "supervisory")
    field(ZNAM, "COMMS ENABLED")
    field(ONAM, "COMMS DISABLED")
}

record(bo, "$(P)AUTOREPORTDISABLE") {
    field(SCAN, "10 second")
	field(DTYP, "stream")
	field(OUT, "@quantumnorthwest.proto disableReports $(PORT)")
}

record(stringin, "$(P)_JUNK") {
    field(DTYP, "stream")
    field(SCAN, "I/O Intr")
    field(INP, "@quantumnorthwest.proto junk $(PORT)")
}

record(mbbi, "$(P)ID") {
    field(DESC, "Sample Holder Type")
	field(SCAN, "5 second")
	field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getID $(PORT)")
    field(ZRST, "Speciality")
    field(ONST, "t2")
    field(TWST, "t2x2")
    field(THST, "turret6")
    info(INTEREST, "LOW")
    info(archive, "VAL")
}

record(ai, "$(P)STIR:SPEED:MAX") {
    field(DESC, "Maximum stirrer speed")
    field(SCAN, "5 second")
    field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getMaxSpeed $(PORT)")
	field(EGU, "rpm")
	field(PREC, "0")
    info(INTEREST, "LOW")
    info(archive, "VAL")
}

record(ai, "$(P)STIR:SPEED:MIN") {
    field(DESC, "Minimum stirrer speed")
    field(SCAN, "5 second")
    field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getMinSpeed $(PORT)")
	field(EGU, "rpm")
	field(PREC, "0")
    info(INTEREST, "LOW")
    info(archive, "VAL")
}

record(ai, "$(P)STIR:SPEED") {
    field(DESC, "Stirrer speed")
    field(SCAN, "5 second")
    field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getSpeed $(PORT)")
	field(EGU, "rpm")
	field(PREC, "0")
    info(INTEREST, "HIGH")
    info(archive, "VAL")
}

record(ao, "$(P)STIR:SPEED:SP") {
    field(DESC, "Set stirrer speed")
    field(DTYP, "stream")
	field(OUT, "@quantumnorthwest.proto setSpeed $(PORT)")
	field(EGU, "rpm")
	field(PREC, "0")
	field(UDFS, "NO_ALARM")
}

record(bi, "$(P)TEMP:ENABLED") {
    field(DESC, "Temperature control enabled")
    field(SCAN, "5 second")
    field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getTempEnab $(PORT)")
    field(ZNAM, "No")
    field(ONAM, "Yes")
    info(INTEREST, "HIGH")
    info(archive, "VAL")
}

record(bo, "$(P)TEMP:ENABLED:SP") {
    field(DESC, "Temperature control enabled")
    field(DTYP, "stream")
	field(OUT, "@quantumnorthwest.proto setTempEnab $(PORT)")
    field(ZNAM, "No")
    field(ONAM, "Yes")
	field(UDFS, "NO_ALARM")
}

record(ai, "$(P)TEMP") {
    field(DESC, "Temperature")
    field(SCAN, "5 second")
    field(DTYP, "stream")
	field(INP, "@quantumnorthwest.proto getTemp $(PORT)")
	field(PREC, "2")
	field(EGU, "C")
    info(INTEREST, "HIGH")
    info(archive, "VAL")
    info(alarm, "QNW")
}

